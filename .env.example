# ========================================
# Configuração de Ambiente - Normais Climatológicas
# ========================================
# Copie este arquivo para .env e configure os valores

# ========================================
# Configuração da API
# ========================================
# Host e porta do servidor
HOST=0.0.0.0
PORT=8000

# Modo debug (development/production)
DEBUG=False
ENVIRONMENT=development

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# URLs permitidas para requisições CORS
# Múltiplas URLs separadas por vírgula
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ========================================
# Banco de Dados (Opcional - para futuro)
# ========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/normais_climatologicas
# DATABASE_ECHO=False

# ========================================
# Logging
# ========================================
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# ========================================
# Cache (Opcional)
# ========================================
# CACHE_ENABLED=True
# CACHE_TTL=3600

# ========================================
# Segurança (Opcional - para futuro)
# ========================================
# SECRET_KEY=sua-chave-secreta-muito-segura-aqui
# API_KEY_ENABLED=False
# API_KEYS=chave1,chave2,chave3

# ========================================
# Dados
# ========================================
# Caminho para o arquivo CSV de dados
DATA_FILE_PATH=dados_climatologicos_processados.csv

# ========================================
# Email (Opcional - para notificações)
# ========================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app
# SMTP_FROM=noreply@example.com
